.btn--quick {

width: 100%;

border-radius: 8px;

padding: 8px 0;

background-color: #0e2e68;

color: #fff;

font-weight: 600;

right: 0px;

transition: none !important;

box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);

