    s.setAttribute('acc', '6fd37667-0faf-48dc-b190-30cbd06ab1af');
    m.parentNode.insertBefore(s, m);
  }

  function loadPrimeWidgets() {
    if (document.querySelector('script[src*="primewidgets.com/customers/ilacsizyasam/init.js"]')) return;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://cdn.primewidgets.com/customers/ilacsizyasam/init.js';
    document.head.appendChild(s);
  }

  var loaded = false;
  function go() {
    if (loaded) return;
    loaded = true;
  }

  function schedule() {
    var events = ['scroll', 'touchstart', 'pointerdown', 'keydown'];
    events.forEach(function (name) {
      window.addEventListener(name, go, { once: true, passive: true });
    });

    window.addEventListener('load', function () {
      go();
    });

    go();
  }

  schedule();
  loadSegmentHub();
  loadPrimeWidgets();
})();
