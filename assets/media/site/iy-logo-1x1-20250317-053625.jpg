    .holly-icon-marquee {
        width: 100%;
        overflow: hidden;
        position: relative;
        will-change: transform;
        min-height: calc(60px + 26px + 18px);
    }

    .marquee-track {
        display: flex;
        position: relative;
        white-space: nowrap;
    }

    .marquee-content {
        display: flex;
        gap: 30px;
        padding-right: 30px;
        width: fit-content;
        animation: scroll 40s linear infinite;
        will-change: transform;
        transform: translateZ(0);
    }

    .holly-icon-marquee-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: start;
        gap: 10px;
        width: 200px;
        text-align: center;
        flex-shrink: 0;
    }

    .holly-icon-marquee-item-icon {
        width: auto;
        height: var(--icon-size);
    }

    .holly-icon-marquee-item-icon img {
        width: auto;
        height: var(--icon-size);
        object-fit: contain;
    }

    .holly-icon-marquee-item-text {
        font-size: 13px;
        font-weight: 700;
        color: #0e2e68;
        white-space: normal;
    }

    @keyframes scroll {
        from {
            transform: translate3d(0, 0, 0);
        }
        to {
            transform: translate3d(-50%, 0, 0);
        }
    }

    .marquee-track:hover .marquee-content {
        animation-play-state: paused;
    }

    @media (max-width: 768px) {
        .holly-icon-marquee {
            min-height: calc(50px + 26px + 18px);
        }
        .holly-icon-marquee-item-text {
            font-size: 13px;
            font-weight: 600;
        }
        .holly-icon-marquee-item-icon {
            width: 50px;
            height: 50px;
        }
    }
</style>

