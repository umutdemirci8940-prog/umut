    id="flash-sale-popup"
    class="flash-sale-popup flash-sale-popup--hidden"
    role="dialog"
    aria-label="Flaş İndirim"
    aria-hidden="true"
    style="
      --flash-brand: #e31010;
      --flash-text: #0e2e68;
      --flash-btn-bg: #0e2e68;
      --flash-btn-text: #10e31b;
      --flash-accent: #10e31b;
      --flash-icon: #e31010;
      --flash-mobile-bottom: 0px;
    "
  ><button type="button" class="flash-sale-popup__close" aria-label="Kapat" data-flash-close>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
      </svg>
