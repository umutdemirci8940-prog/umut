  </div>

  <style>
    .flash-sale-popup {
      position: fixed;
      z-index: 101;
      right: 20px;
      bottom: 20px;
      width: min(420px, calc(100vw - 32px));
      padding: 0;
      background: #fff;
      color: var(--flash-brand);
      border: 2px solid var(--flash-brand);
      border-radius: 16px;
      box-sizing: border-box;
      box-shadow:
        0 16px 40px rgba(14, 46, 104, 0.12),
        0 2px 8px rgba(14, 46, 104, 0.06);
      transform: translateX(calc(100% + 28px));
      opacity: 0;
      visibility: hidden;
      transition:
        transform 0.48s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.32s ease,
        visibility 0.32s;
      pointer-events: none;
      font-family: inherit;
      overflow: hidden;
    }

    .flash-sale-popup--visible {
      transform: translateX(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .flash-sale-popup--hidden {
      transform: translateX(calc(100% + 28px));
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .flash-sale-popup__close {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 2;
      width: 30px;
      height: 30px;
      border: 0;
      border-radius: 50%;
      background: #fff;
      color: #8a94a6;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      box-shadow: 0 1px 4px rgba(14, 46, 104, 0.12);
      transition: color 0.15s ease, transform 0.15s ease;
    }

    .flash-sale-popup__close:hover {
      color: var(--flash-brand);
      transform: scale(1.05);
    }

    .flash-sale-popup__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 16px 48px 14px 18px;
      border-bottom: 1px solid #eef2f7;
    }

    .flash-sale-popup__title-row {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }

    .flash-sale-popup__heading {
      margin: 0;
      font-size: 16px;
      font-weight: 700;
      color: var(--flash-brand);
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    .flash-sale-popup__title-row .flash-sale-popup__icon {
      display: flex;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      color: var(--flash-icon, var(--flash-brand));
    }

    .flash-sale-popup__icon .icon {
      width: 20px;
      height: 20px;
    }

    .flash-sale-popup__counter {
      flex-shrink: 0;
      font-size: 12px;
      font-weight: 600;
      color: #7a8499;
      font-variant-numeric: tabular-nums;
    }

    .flash-sale-popup__body {
      padding: 16px 18px 18px;
    }

    .flash-sale-popup__body--carousel {
      display: grid;
      grid-template-columns: 28px 1fr 28px;
      gap: 6px;
      align-items: center;
      padding-left: 8px;
      padding-right: 8px;
    }

    .flash-sale-popup__nav {
      width: 28px;
      height: 56px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: var(--flash-brand);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      opacity: 0.55;
      transition: opacity 0.15s ease, background 0.15s ease;
    }

    .flash-sale-popup__nav:hover {
      opacity: 1;
      background: #f4f7fb;
    }

    .flash-sale-popup__viewport {
      overflow: hidden;
      min-width: 0;
      width: 100%;
    }

    .flash-sale-popup__track {
      display: flex;
      width: 100%;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    .flash-sale-popup__slide {
      flex: 0 0 100%;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    .flash-sale-popup__content {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .flash-sale-popup__product {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .flash-sale-popup__thumb {
      position: relative;
      flex-shrink: 0;
      display: block;
      width: 104px;
      height: 104px;
      border-radius: 12px;
      overflow: hidden;
      background: #f6f8fb;
    }

    .flash-sale-popup__thumb svg {
      width: 104px;
      height: 104px;
    }

    .flash-sale-popup__image {
      width: 104px;
      height: 104px;
      object-fit: cover;
      display: block;
    }

    .flash-sale-popup__discount {
      position: absolute;
      top: 6px;
      left: 6px;
      z-index: 1;
      padding: 3px 6px;
      border-radius: 6px;
      background: var(--flash-brand);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .flash-sale-popup__meta {
      flex: 1;
      min-width: 0;
      padding-top: 2px;
    }

    .flash-sale-popup__product-title {
      color: var(--flash-brand);
      text-decoration: none;
      font-size: 17px;
      font-weight: 600;
      line-height: 1.35;
      margin: 0 0 8px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .flash-sale-popup__product-title:hover {
      text-decoration: underline;
    }

    .flash-sale-popup__price-line {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px 8px;
      margin: 0;
    }

    .flash-sale-popup__price {
      font-size: 22px;
      font-weight: 700;
      color: var(--flash-brand);
      line-height: 1.2;
    }

    .flash-sale-popup__compare {
      font-size: 15px;
      font-weight: 500;
      color: #9aa3b2;
      text-decoration: line-through;
    }

    .flash-sale-popup__form {
      margin: 0;
      width: 100%;
    }

    .flash-sale-popup__form button.is-loading .btn__loader {
      opacity: 1 !important;
    }

    .flash-sale-popup__form button.is-loading .button-text {
      opacity: 0 !important;
    }

    .flash-sale-popup__form button.is-loading {
      pointer-events: none;
    }

    @media (max-width: 749px) {
      .flash-sale-popup {
        left: 12px;
        right: 12px;
        bottom: calc(12px + var(--flash-mobile-bottom));
        width: auto;
        transform: translate3d(0, calc(100% + 24px), 0);
      }

      .flash-sale-popup--visible {
        transform: translate3d(0, 0, 0);
      }

      .flash-sale-popup--hidden {
        transform: translate3d(0, calc(100% + 24px), 0);
      }

      .flash-sale-popup__thumb,
      .flash-sale-popup__image,
      .flash-sale-popup__thumb svg {
        width: 88px;
        height: 88px;
      }
    }
  </style>

  <script>
    (function () {
      const popup = document.getElementById('flash-sale-popup');
      if (!popup) return;

      const config = {
        showDelay: 2000,
        autoSlideMs: 5000,
        frequency: "always",
        storageKey: 'flash-sale-popup-dismissed-sections--23015507067178__flash_sale_popup_itn4UF',
        sessionKey: 'flash-sale-popup-session-sections--23015507067178__flash_sale_popup_itn4UF'
      };

      const viewport = popup.querySelector('.flash-sale-popup__viewport');
      const track = popup.querySelector('[data-flash-track]');
      const slides = Array.from(popup.querySelectorAll('[data-flash-slide]'));
      const counterEl = popup.querySelector('[data-flash-counter]');
      const prevBtn = popup.querySelector('[data-flash-prev]');
      const nextBtn = popup.querySelector('[data-flash-next]');
      let index = 0;
      let autoTimer = null;
      let isVisible = false;

      function applySlideTransform() {
        if (!viewport || !track) return;
        const slideWidth = viewport.getBoundingClientRect().width;
        track.style.transform = 'translate3d(-' + index * slideWidth + 'px, 0, 0)';
      }

      function shouldShow() {
        if (config.frequency === 'always') return true;
        if (config.frequency === 'session') {
          return !sessionStorage.getItem(config.sessionKey);
        }
        const raw = localStorage.getItem(config.storageKey);
        if (!raw) return true;
        const dismissedAt = parseInt(raw, 10);
        if (Number.isNaN(dismissedAt)) return true;
        const elapsed = Date.now() - dismissedAt;
        if (config.frequency === 'daily') return elapsed >= 86400000;
        if (config.frequency === 'weekly') return elapsed >= 604800000;
        return true;
      }

      function markDismissed() {
        if (config.frequency === 'session') {
          sessionStorage.setItem(config.sessionKey, '1');
          return;
        }
        if (config.frequency !== 'always') {
          localStorage.setItem(config.storageKey, String(Date.now()));
        }
      }

      function updateSlide(nextIndex, userTriggered) {
        if (!slides.length) return;
        index = (nextIndex + slides.length) % slides.length;
        applySlideTransform();
        if (counterEl) counterEl.textContent = (index + 1) + ' / ' + slides.length;
        if (userTriggered) restartAutoSlide();
      }

      function restartAutoSlide() {
        if (autoTimer) clearInterval(autoTimer);
        if (slides.length <= 1 || !isVisible) return;
        autoTimer = setInterval(function () {
          updateSlide(index + 1, false);
        }, config.autoSlideMs);
      }

      function showPopup() {
        popup.classList.remove('flash-sale-popup--hidden');
        popup.classList.add('flash-sale-popup--visible');
        popup.setAttribute('aria-hidden', 'false');
        isVisible = true;
        requestAnimationFrame(function () {
          applySlideTransform();
          restartAutoSlide();
        });
      }

      function hidePopup(persist) {
        popup.classList.remove('flash-sale-popup--visible');
        popup.classList.add('flash-sale-popup--hidden');
        popup.setAttribute('aria-hidden', 'true');
        isVisible = false;
        if (autoTimer) clearInterval(autoTimer);
        if (persist) markDismissed();
      }

      popup.querySelector('[data-flash-close]').addEventListener('click', function () {
        hidePopup(true);
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          updateSlide(index - 1, true);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          updateSlide(index + 1, true);
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isVisible) hidePopup(true);
      });

      window.addEventListener('resize', function () {
        if (isVisible) applySlideTransform();
      });

      if (shouldShow()) {
        setTimeout(showPopup, config.showDelay);
      }
    })();
