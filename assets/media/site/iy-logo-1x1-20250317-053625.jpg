</header><script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": "İlaçsız Yaşam",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https:\/\/ilacsizyasam.com\/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      },
      "url": "https:\/\/ilacsizyasam.com"
    }
  </script><script>
  document.addEventListener('DOMContentLoaded', function () {
    const wrapperEl = document.getElementById('typing-placeholder');
    const searchInput = document.getElementById('searchInput-center-search');

    const wrapperElMobile = document.getElementById('typing-placeholder-mobile');
    const searchInputMobile = document.querySelector('.desktop-hide .search-form__input');

    const prompts = [
      'Ara: Yorgunluğun azalması',
      'Ara: Bağışıklık sistemi',
      'Ara: Cilt, saç ve tırnak sağlığı',
      'Ara: Sinir sistemine katkı',
    ];

    function initTypingEffect(wrapperElement, inputElement) {
      if (!wrapperElement || !inputElement) return;

      let currentIndex = 0;
      let isClicked = false;

      inputElement.addEventListener('click', function () {
        isClicked = true;
        wrapperElement.style.display = 'none';
      });

      inputElement.addEventListener('blur', function () {
        if (inputElement.value === '') {
          isClicked = false;
          wrapperElement.style.display = 'block';
        }
      });

      function deleteText(callback) {
        if (isClicked) return callback();
        const currentText = wrapperElement.getAttribute('data-placeholder') || '';
        const stopAt = 4;
        let i = currentText.length;

        function deleteNext() {
          if (i > stopAt) {
            i--;
            wrapperElement.setAttribute('data-placeholder', currentText.substring(0, i));
            setTimeout(deleteNext, 80);
          } else {
            callback();
          }
        }
        deleteNext();
      }

      function typeText(text, callback) {
        const base = text.substring(0, 4);
        let i = 4;
        if (!isClicked) {
          wrapperElement.setAttribute('data-placeholder', base);
        }

        function typeNext() {
          if (i < text.length) {
            if (!isClicked) {
              wrapperElement.setAttribute('data-placeholder', text.substring(0, i + 1));
            }
            i++;
            setTimeout(typeNext, 100);
          } else {
            setTimeout(callback, 2000);
          }
        }
        setTimeout(typeNext, 100);
      }

      function startLoop() {
        deleteText(() => {
          typeText(prompts[currentIndex], () => {
            currentIndex = (currentIndex + 1) % prompts.length;
            startLoop();
          });
        });
      }

      typeText(prompts[0], () => {
        currentIndex = 1;
        setTimeout(() => {
          startLoop();
        }, 2000);
      });
    }

    initTypingEffect(wrapperEl, searchInput);
    initTypingEffect(wrapperElMobile, searchInputMobile);
  });
</script>


