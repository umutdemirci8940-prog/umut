.mobile_quick_buy_holly {

display: block;

margin-top: 70px;

}

.mobile_quick_buy_holly svg{

display: block;

}

.mobile_quick_buy_holly .btn__inner{

display: none;

}

  

.btn--quick {

width: 100%;

border-radius: 8px;

padding: 8px 0;

background-color: #0e2e68;

color: #fff;

font-weight: 600;

right: 0px;

transition: none !important;

box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);

}

  

.btn_line{

display: flex;

align-items: center;

justify-content: center;

gap: 8px;

}

  

.btn__inner{

box-shadow: none !important;

padding: 0px !important;

color: #0e2e68 !important;

width: 100px;

}

.btn_icon_holly{

width: 34px;

height: 34px;

color: #0e2e68;

}

  

.btn__text_mobile{

font-size: 12px !important;

font-weight: 600;

}

  

.loader_div{

display: flex;

align-items: center;

justify-content: center;

width: 100%;

}

  

.loader_div .btn__loader{

position: absolute;

top: 20%;

right: 43%;

}

.btn__loader svg{

stroke-width: 1.5px;

}

  

.btn--quick .btn__text_mobile{

display: block;

white-space: nowrap;

overflow: hidden;

}

  

.btn--quick:hover .btn__inner {

transition: none !important;

}

  

.btn--quick:hover .btn__text_mobile {

padding-right: 0px !important;

}

  

.btn--quick.is-loading .btn__text_mobile {

opacity: 0;

padding: 0;

}

  

.btn--quick .icon {

stroke-width: calc(var(--STROKE-WIDTH));

width: 25px;

overflow: hidden;

flex: 0 0 25px;

}

  

}

