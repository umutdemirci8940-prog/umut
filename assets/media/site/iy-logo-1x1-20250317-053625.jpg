<div id="shopify-section-sections--23015507132714__holly_newsletter_mtDxH3" class="shopify-section shopify-section-group-group-footer"><script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('newsletterFooter', () => ({
            firstName: '',
            lastName: '',
            email: '',
            termsAccepted: false,
            marketingAccepted: false,
            formSuccess: false,
            formError: false,
            
            isEmailValid() {
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                return emailRegex.test(this.email);
            },
            
            get isFormValid() {
                return this.firstName.trim() !== '' && 
                    this.lastName.trim() !== '' && 
                    this.email.trim() !== '' && 
                    this.isEmailValid() && 
                    this.termsAccepted && 
                    this.marketingAccepted;
            },
            
            handleSubmit(event) {
                if (!this.isFormValid) {
                    event.preventDefault();
                }
            }
        }));
    });
</script>

