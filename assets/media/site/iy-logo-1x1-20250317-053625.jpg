    <script>
  (function () {
    if (window.__productOfDayBadgesRotatorLoaded) return;
    window.__productOfDayBadgesRotatorLoaded = true;

    function isMeasurable(container) {
      if (!container || !container.isConnected) return false;

      var tab = container.closest('.tab');
      if (tab && !tab.classList.contains('current')) return false;

      var style = window.getComputedStyle(container);
      if (style.display === 'none' || style.visibility === 'hidden') return false;
      if (style.contentVisibility === 'hidden') return false;

      return container.getBoundingClientRect().width > 0;
    }

    function resetRotator(container) {
      delete container.dataset.rotatorInit;

      var viewport = container.querySelector('[class*="__viewport"]');
      var track = container.querySelector('[class*="__track"]');

      container.style.minHeight = '';

      if (viewport) {
        viewport.style.height = '';
        viewport.style.maxHeight = '';
        viewport.style.minHeight = '';
      }

      if (track) {
        track.style.transform = '';
        track.style.transition = '';
        Array.prototype.forEach.call(track.children, function (item) {
          item.style.minHeight = '';
          item.style.height = '';
        });
        Array.prototype.forEach.call(track.querySelectorAll('[data-rotator-clone]'), function (clone) {
          clone.remove();
        });
      }

      if (container.__podBadgeIntervalId) {
        clearInterval(container.__podBadgeIntervalId);
        container.__podBadgeIntervalId = null;
      }
    }

    function initSlideRotator(container) {
      var viewport = container.querySelector('[class*="__viewport"]');
      var track = container.querySelector('[class*="__track"]');
      if (!viewport || !track) return false;

      if (!isMeasurable(container)) return false;

      var index = 0;
      var stepHeight = 0;
      var originalCount = 0;
      var clone = null;
      var onTransitionEnd = null;

      function getOriginalItems() {
        return Array.prototype.filter.call(track.children, function (child) {
          return !child.hasAttribute('data-rotator-clone');
        });
      }

      function removeClone() {
        if (clone) {
          clone.remove();
          clone = null;
        }
        Array.prototype.forEach.call(track.querySelectorAll('[data-rotator-clone]'), function (node) {
          node.remove();
        });
      }

      function setupClone() {
        removeClone();

        var items = getOriginalItems();
        originalCount = items.length;

        if (originalCount <= 1) return;

        clone = items[0].cloneNode(true);
        clone.setAttribute('data-rotator-clone', 'true');
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      }

      function applyTransform(animate) {
        if (!animate) track.style.transition = 'none';
        track.style.transform = 'translate3d(0, -' + (index * stepHeight) + 'px, 0)';
        if (!animate) {
          track.offsetHeight;
          track.style.transition = '';
        }
      }

      function measure(resetIndex) {
        if (!isMeasurable(container)) return false;

        if (resetIndex) index = 0;

        removeClone();

        var originals = getOriginalItems();
        if (!originals.length) return false;

        Array.prototype.forEach.call(originals, function (item) {
          item.style.minHeight = '';
          item.style.height = '';
        });

        viewport.style.height = 'auto';
        viewport.style.maxHeight = 'none';
        viewport.style.minHeight = '0';
        container.style.minHeight = '0';

        var maxHeight = 0;

        Array.prototype.forEach.call(originals, function (item) {
          maxHeight = Math.max(maxHeight, item.getBoundingClientRect().height);
        });

        if (!maxHeight) return false;

        originalCount = originals.length;
        setupClone();

        Array.prototype.forEach.call(track.children, function (item) {
          item.style.height = maxHeight + 'px';
          item.style.minHeight = maxHeight + 'px';
        });

        viewport.style.height = maxHeight + 'px';
        viewport.style.maxHeight = maxHeight + 'px';
        viewport.style.minHeight = '0';
        stepHeight = maxHeight;
        applyTransform(false);
        return true;
      }

      onTransitionEnd = function (event) {
        if (event.target !== track || event.propertyName !== 'transform') return;
        if (index !== originalCount) return;
        index = 0;
        applyTransform(false);
      };

      resetRotator(container);

      if (!measure(false)) return false;

      container.dataset.rotatorInit = 'true';

      if (originalCount <= 1) return true;

      track.removeEventListener('transitionend', onTransitionEnd);
      track.addEventListener('transitionend', onTransitionEnd);

      if (container.__podBadgeIntervalId) clearInterval(container.__podBadgeIntervalId);

      container.__podBadgeIntervalId = setInterval(function () {
        index += 1;
        applyTransform(true);
      }, 3000);

      if (!container.__podBadgeResizeBound) {
        container.__podBadgeResizeBound = true;
        window.addEventListener('resize', function () {
          if (!container.dataset.rotatorInit) {
            initSlideRotator(container);
            return;
          }
          measure(true);
        });
      }

      return true;
    }

    function initProductOfDayBadgesRotators() {
      document.querySelectorAll('[data-product-of-day-top-badges], [data-product-of-day-bottom-badges]').forEach(function (container) {
        if (container.dataset.rotatorInit) return;
        initSlideRotator(container);
      });
    }

    function refreshTabBadges(tab) {
      if (!tab) return;

      tab.querySelectorAll('[data-product-of-day-top-badges], [data-product-of-day-bottom-badges]').forEach(function (container) {
        resetRotator(container);
        initSlideRotator(container);
      });
    }

    function scheduleInit() {
      initProductOfDayBadgesRotators();

      requestAnimationFrame(function () {
        initProductOfDayBadgesRotators();
      });

      window.setTimeout(function () {
        initProductOfDayBadgesRotators();
      }, 150);
    }

    document.addEventListener('DOMContentLoaded', scheduleInit);
    document.addEventListener('shopify:section:load', scheduleInit);
    window.addEventListener('load', scheduleInit);

    document.addEventListener('click', function (event) {
      var tabLink = event.target.closest('[data-tabs-link]');
      if (!tabLink) return;

      window.setTimeout(function () {
        var section = tabLink.closest('[data-section-type="tab-collections"]');
        if (!section) return;
        var activeTab = section.querySelector('.tab.current');
        refreshTabBadges(activeTab);
      }, 50);
    });

    scheduleInit();
  })();
</script>


