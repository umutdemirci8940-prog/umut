font-weight: 600;

}

  

.loader_div{

display: flex;

align-items: center;

justify-content: center;

width: 100%;

}

  

.loader_div .btn__loader{

position: absolute;

top: 20%;

right: 43%;

}

.btn__loader svg{

stroke-width: 1.5px;

}

  

.btn--quick .btn__text_mobile{

display: block;

white-space: nowrap;

overflow: hidden;

}

  

.btn--quick:hover .btn__inner {

transition: none !important;

}

  

.btn--quick:hover .btn__text_mobile {

padding-right: 0px !important;

}

  

.btn--quick.is-loading .btn__text_mobile {

opacity: 0;

padding: 0;

}

  

.btn--quick .icon {

stroke-width: calc(var(--STROKE-WIDTH));

width: 25px;

overflow: hidden;

flex: 0 0 25px;

}

  

}

