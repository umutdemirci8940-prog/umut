<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slideshow = document.getElementById('Slideshow--template--23015507493162__section-slideshow-0');
    if (!slideshow) return;

    function updateCountdown(countdownElement) {
      const startDate = parseInt(countdownElement.dataset.startDate) * 1000;
      const endDate = parseInt(countdownElement.dataset.endDate) * 1000;
      const now = new Date().getTime();
      
      if (now >= startDate && now <= endDate) {
        const distance = endDate - now;
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);
        
        countdownElement.querySelector('.countdown__days').textContent = days.toString().padStart(2, '0');
        countdownElement.querySelector('.countdown__hours').textContent = hours.toString().padStart(2, '0');
        countdownElement.querySelector('.countdown__minutes').textContent = minutes.toString().padStart(2, '0');
        countdownElement.querySelector('.countdown__seconds').textContent = seconds.toString().padStart(2, '0');
        countdownElement.style.display = 'block';
      } else {
        countdownElement.style.display = 'none';
      }
    }

    slideshow.querySelectorAll('.slide__countdown').forEach(countdown => {
      updateCountdown(countdown);
      setInterval(() => updateCountdown(countdown), 1000);
    });

    function pad(value) {
      return value.toString().padStart(2, '0');
    }

    function miniTargetTime(el) {
      var now = new Date();
      var mode = el.dataset.timerMode || 'daily';
      var endDate = el.dataset.endDate || '';

      if (mode === 'fixed' && endDate) {
        var parts = endDate.split('-');
        var tm = (el.dataset.endTime || '23:59').split(':');
        return new Date(
          parseInt(parts[0], 10),
          parseInt(parts[1], 10) - 1,
          parseInt(parts[2], 10),
          parseInt(tm[0], 10) || 0,
          parseInt(tm[1], 10) || 0,
          0
        );
      }
      // Daily: roll to the end of the current day (local time)
      return new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999);
    }

    function updateMiniCountdown(el) {
      var diff = Math.max(0, Math.floor((miniTargetTime(el) - new Date()) / 1000));
      var showDays = el.dataset.showDays === 'true';

      var days = Math.floor(diff / 86400);
      var hours = Math.floor((diff % 86400) / 3600);
      var minutes = Math.floor((diff % 3600) / 60);
      var seconds = diff % 60;

      var daysEl = el.querySelector('[data-mc-days]');
      if (showDays && daysEl) {
        daysEl.textContent = pad(days);
      } else {
        hours = hours + days * 24;
      }
      el.querySelector('[data-mc-hours]').textContent = pad(hours);
      el.querySelector('[data-mc-minutes]').textContent = pad(minutes);
      el.querySelector('[data-mc-seconds]').textContent = pad(seconds);
    }

    slideshow.querySelectorAll('[data-mini-countdown]').forEach(mini => {
      updateMiniCountdown(mini);
      setInterval(() => updateMiniCountdown(mini), 1000);
    });

    function getVisibleSlideVideo(slide) {
      if (!slide) return null;
      const sources = slide.querySelectorAll('.slide__video-source');
      for (const source of sources) {
        if (window.getComputedStyle(source).display !== 'none') {
          const video = source.querySelector('[data-slide-video]');
          if (video) return video;
        }
      }
      return slide.querySelector('[data-slide-video]');
    }

    function shouldWaitForVideoEnd(slide) {
      const video = getVisibleSlideVideo(slide);
      if (!video) return false;
      return video.dataset.waitUntilEnd === 'true' && video.dataset.videoLoop !== 'true';
    }

    let flktyInstance = null;
    let activeVideoEndHandler = null;
    let activeVideoForEnd = null;

    function clearVideoEndHandler() {
      if (activeVideoForEnd && activeVideoEndHandler) {
        activeVideoForEnd.removeEventListener('ended', activeVideoEndHandler);
      }
      activeVideoForEnd = null;
      activeVideoEndHandler = null;
    }

    function playSlideVideo(video) {
      if (!video) return;

      if (video.preload === 'none') {
        video.preload = 'auto';
        video.load();
      }

      const startPlayback = () => {
        video.play().catch(() => {});
      };

      if (video.readyState >= HTMLMediaElement.HAVE_ENOUGH_DATA) {
        startPlayback();
        return;
      }

      video.addEventListener('canplaythrough', startPlayback, { once: true });
    }

    function syncSlideshowWithActiveVideo() {
      stopAllSlideVideos();

      const activeSlide = flktyInstance
        ? flktyInstance.selectedElement
        : (slideshow.querySelector('.item.is-selected') || slideshow.querySelector('.item'));
      const video = getVisibleSlideVideo(activeSlide);
      const controls = activeSlide ? activeSlide.querySelector('[data-slide-video-controls]') : null;

      clearVideoEndHandler();

      if (video) {
        video.currentTime = 0;

        if (video.dataset.autoplay === 'true') {
          playSlideVideo(video);
        }
      }

      if (video && controls) {
        updateVideoControlIcons(video, controls);
      }

      if (!flktyInstance) return;

      if (shouldWaitForVideoEnd(activeSlide)) {
        flktyInstance.pausePlayer();

        if (video) {
          activeVideoForEnd = video;
          activeVideoEndHandler = () => {
            clearVideoEndHandler();
            if (flktyInstance && flktyInstance.selectedElement === activeSlide) {
              flktyInstance.next(true);
            }
          };
          video.addEventListener('ended', activeVideoEndHandler);
        }
      } else if (slideshow.dataset.autoplay === 'true') {
        flktyInstance.playPlayer();
      }
    }

    function updateVideoControlIcons(video, controls) {
      if (!video || !controls) return;
      const playIcon = controls.querySelector('[data-icon-play]');
      const pauseIcon = controls.querySelector('[data-icon-pause]');
      const soundOnIcon = controls.querySelector('[data-icon-sound-on]');
      const soundOffIcon = controls.querySelector('[data-icon-sound-off]');

      if (playIcon && pauseIcon) {
        playIcon.classList.toggle('is-hidden', !video.paused);
        pauseIcon.classList.toggle('is-hidden', video.paused);
      }

      if (soundOnIcon && soundOffIcon) {
        soundOnIcon.classList.toggle('is-hidden', video.muted);
        soundOffIcon.classList.toggle('is-hidden', !video.muted);
      }
    }

    function stopAllSlideVideos() {
      slideshow.querySelectorAll('[data-slide-video]').forEach(video => {
        video.pause();
        video.currentTime = 0;
      });
    }

    slideshow.querySelectorAll('[data-slide-video-controls]').forEach(controls => {
      const slide = controls.closest('.item');
      const playToggle = controls.querySelector('[data-video-play-toggle]');
      const muteToggle = controls.querySelector('[data-video-mute-toggle]');

      function bindVideoEvents(video) {
        if (!video || video.dataset.controlsBound === 'true') return;
        video.dataset.controlsBound = 'true';

        video.addEventListener('play', () => updateVideoControlIcons(video, controls));
        video.addEventListener('pause', () => updateVideoControlIcons(video, controls));
        video.addEventListener('volumechange', () => updateVideoControlIcons(video, controls));
        updateVideoControlIcons(video, controls);
      }

      bindVideoEvents(getVisibleSlideVideo(slide));

      if (playToggle) {
        playToggle.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const video = getVisibleSlideVideo(slide);
          if (!video) return;
          bindVideoEvents(video);
          if (video.paused) {
            playSlideVideo(video);
          } else {
            video.pause();
          }
        });
      }

      if (muteToggle) {
        muteToggle.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const video = getVisibleSlideVideo(slide);
          if (!video) return;
          bindVideoEvents(video);
          video.muted = !video.muted;
          updateVideoControlIcons(video, controls);
        });
      }
    });

    function bindSlideshowVideoChanges() {
      if (typeof Flickity === 'undefined') {
        requestAnimationFrame(bindSlideshowVideoChanges);
        return;
      }

      flktyInstance = Flickity.data(slideshow);
      if (!flktyInstance) {
        requestAnimationFrame(bindSlideshowVideoChanges);
        return;
      }

      flktyInstance.on('change', () => {
        syncSlideshowWithActiveVideo();
      });

      syncSlideshowWithActiveVideo();
    }

    bindSlideshowVideoChanges();

    slideshow.querySelectorAll('[data-slide-video]').forEach(video => {
      video.addEventListener('loadedmetadata', () => {
        if (!flktyInstance || slideshow.dataset.adaptiveHeight === 'false') return;
        flktyInstance.resize();
      });
    });

    window.addEventListener('resize', () => {
      const activeSlide = flktyInstance
        ? flktyInstance.selectedElement
        : (slideshow.querySelector('.item.is-selected') || slideshow.querySelector('.item'));
      const controls = activeSlide ? activeSlide.querySelector('[data-slide-video-controls]') : null;
      const video = getVisibleSlideVideo(activeSlide);
      if (video && controls) {
        updateVideoControlIcons(video, controls);
      }
    });
  });
</script>

