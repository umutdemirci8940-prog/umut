    <script>
      (function () {
        var PR_KEYS = ['pr_prod_strat', 'pr_rec_id', 'pr_rec_pid', 'pr_ref_pid', 'pr_seq'];

        function hasPrParams(url) {
          var params = new URLSearchParams(url.search);
          for (var i = 0; i < PR_KEYS.length; i++) {
            if (params.has(PR_KEYS[i])) return true;
          }
          return false;
        }

        if (hasPrParams(window.location)) {
          var meta = document.createElement('meta');
          meta.name = 'robots';
          meta.content = 'noindex,nofollow';
          if (document.head) document.head.appendChild(meta);
        }

        function cleanHref(href) {
          if (!href) return null;

          try {
            var url = new URL(href, window.location.origin);
            var changed = false;

            for (var i = 0; i < PR_KEYS.length; i++) {
              if (url.searchParams.has(PR_KEYS[i])) {
                url.searchParams.delete(PR_KEYS[i]);
                changed = true;
              }
            }

            if (!changed) return null;

            return url.pathname + url.search + url.hash;
          } catch (e) {
            return null;
          }
        }

        function cleanElement(el) {
          if (!el || el.nodeType !== 1) return;

          if (el.tagName === 'A' && el.hasAttribute('href')) {
            var cleaned = cleanHref(el.getAttribute('href'));
            if (cleaned !== null) el.setAttribute('href', cleaned);
          }

          if (el.querySelectorAll) {
            var links = el.querySelectorAll('a[href]');
            for (var i = 0; i < links.length; i++) {
              var cleanedLink = cleanHref(links[i].getAttribute('href'));
              if (cleanedLink !== null) links[i].setAttribute('href', cleanedLink);
            }
          }
        }

        function init() {
          if (!document.body) return;

          cleanElement(document.body);

          var observer = new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
              var added = mutations[i].addedNodes;
              for (var j = 0; j < added.length; j++) {
                cleanElement(added[j]);
              }
            }
          });

          observer.observe(document.body, {
            childList: true,
            subtree: true
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
