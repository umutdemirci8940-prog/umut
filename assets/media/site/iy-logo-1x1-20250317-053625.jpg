    <!-- Cart Limit Error Toast -->
    <script>
    const ANIMATION_DURATION = 5000;

    requestAnimationFrame(() => {
        document.addEventListener('alpine:init', () => {
            Alpine.store('xCartEventsError', {
                hasError: false,
                errorMessage: '',
                errorTimeout: null,
                animationRunning: false,
                showError(message = 'Bir Hata Oluştu') {
                    if (this.errorTimeout) {
                        clearTimeout(this.errorTimeout);
                    }

                    this.errorMessage = message;
                    this.hasError = true;

                    this.restartAnimation();

                    this.errorTimeout = setTimeout(() => {
                        this.hasError = false;
                        this.animationRunning = false;
                    }, ANIMATION_DURATION);
                },
                hideError() {
                    this.hasError = false;
                    this.animationRunning = false;
                    if (this.errorTimeout) {
                        clearTimeout(this.errorTimeout);
                        this.errorTimeout = null;
                    }
                },
                restartAnimation() {
                    this.animationRunning = false;

                    const progressBars = document.querySelector('.toast-progress-bar');
                    if (progressBars) {
                        progressBars.classList.remove('toast-progress-animation');
                        progressBars.offsetHeight;
                        progressBars.classList.add('toast-progress-animation');
                    }

                    requestAnimationFrame(() => {
                        this.animationRunning = true;
                    });
                },
                async checkCartQtyLimit(id, isKey = false, increaseQty = 1) {
                    const CART_QTY_LIMIT = 25;
                    try {
                        
                        const variantId = isKey ? id.split(':')[0] : id;
                        
                        const response = await fetch('/cart.js');
                        const cart = await response.json();

                        const existingItems = cart.items.filter(
                            item => item.variant_id == Number(variantId)
                        );
                        
                        const existingItemQuantity = existingItems.reduce(
                            (acc, item) => acc + item.quantity,
                            0
                        );
                        
                        if (existingItemQuantity + increaseQty > CART_QTY_LIMIT) {
                            this.showError('Bir üründen maksimum 25 adet satın alınabilmektedir.');
                            return true;
                        }
                        
                        return false;
                    } catch (error) {
                        return false;
                    }
                },
            });
        });
    });
</script>

