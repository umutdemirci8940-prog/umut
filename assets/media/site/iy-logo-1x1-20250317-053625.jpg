    <script>
        if(typeof Geolizr.foundOldVersion !== "undefined" && Geolizr.foundOldVersion === false) {
            /*
             * Body classes for theme styling / debugging:
             *   geolizr-redirect-loading  -> redirect is being evaluated
             *   geolizr-redirect-start    -> a redirect matched and is executed (code 200)
             *   geolizr-no-redirect       -> no redirect executed (any other code)
             *   geolizr-redirect-blocked  -> additionally set when a redirect exists but was blocked (code != 404)
             * The reason code is exposed as data-geolizr-redirect-code on <body>.
             */
            Geolizr.redirectResultClasses = function(result) {
                let code = result && typeof result.code !== "undefined" ? String(result.code) : "";
                document.body.classList.remove('geolizr-redirect-loading');
                document.body.dataset.geolizrRedirectCode = code;
                if(code === "200") {
                    document.body.classList.add('geolizr-redirect-start');
                } else {
                    document.body.classList.add('geolizr-no-redirect');
                    if(code !== "404") {
                        document.body.classList.add('geolizr-redirect-blocked');
                    }
                }
            };

            Geolizr.init(function() {
                document.body.classList.add('geolizr-redirect-loading');
                Geolizr.addEventListener('redirect.executed', Geolizr.redirectResultClasses);
            });

