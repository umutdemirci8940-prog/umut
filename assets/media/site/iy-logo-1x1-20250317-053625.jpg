(function () {
  function loadSegmentHub() {
    if (document.getElementById('segment_hub_sdk')) return;
    var s = document.createElement('script');
    var m = document.getElementsByTagName('script')[0];
    s.id = 'segment_hub_sdk';
    s.async = 1;
