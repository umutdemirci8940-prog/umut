     /* Bottom position quick add button loading states */
     .quick__form button.is-loading .btn__loader {
       opacity: 1 !important;
     }
     
     .quick__form button.is-loading .button-text {
       opacity: 0 !important;
     }
     
     .quick__form button.is-loading {
       pointer-events: none;
     }
     
     .quick__form button.is-loading .btn__loader circle ~ circle {
       animation-play-state: running;
     }
    
    /* Spin animation for loading circle */
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
