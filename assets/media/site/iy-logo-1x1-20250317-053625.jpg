display: block;

}

.mobile_quick_buy_holly .btn__inner{

display: none;

}

  

.btn--quick {

width: 100%;

border-radius: 8px;

padding: 8px 0;

background-color: #0e2e68;

color: #fff;

font-weight: 600;

right: 0px;

transition: none !important;

box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);

}

  

.btn_line{

display: flex;

align-items: center;

justify-content: center;

gap: 8px;

}

  

.btn__inner{

box-shadow: none !important;

padding: 0px !important;

color: #0e2e68 !important;

width: 100px;

}

.btn_icon_holly{

width: 34px;

height: 34px;

color: #0e2e68;

}

  

.btn__text_mobile{

