    <script>
(function(){
  const urlParams = new URLSearchParams(window.location.search);
  const pfxValue = urlParams.get('pfx');

  if (pfxValue) {
    const cookieName = "aff_pfx";
    const cookieValue = pfxValue;
    const expirationTimeInSeconds = 604800; 

    const date = new Date();
    date.setTime(date.getTime() + (expirationTimeInSeconds * 1000));
    const expires = "expires=" + date.toUTCString();

    document.cookie = `${cookieName}=${cookieValue};${expires};path=/; SameSite=None; Secure; domain=.${location.hostname.replace(/^www\./i, "")}`;
    
    if (localStorage) {
      localStorage.setItem("aff_pfx", cookieValue);
    }
  }
})();
</script>
