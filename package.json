{
  "name": "ilacsizyasam-supplement-banners",
  "version": "1.0.0",
  "private": true,
  "description": "İlaçsız Yaşam – gıda takviyeleri için animasyonlu, ürün slider'lı HTML5 banner serisi (300x250, 300x600, 970x250)",
  "scripts": {
    "build": "node build.js",
    "build:vector": "node build.js --vector",
    "fetch-assets": "node tools/fetch-assets.js",
    "optimize-assets": "NODE_PATH=$(npm root -g) node tools/optimize-assets.js",
    "package": "node tools/package.js",
    "capture": "NODE_PATH=$(npm root -g) node tools/capture.js",
    "capture:video": "NODE_PATH=$(npm root -g) node tools/capture.js --video",
    "test": "NODE_PATH=$(npm root -g) node tools/smoke.js",
    "preview": "npx --yes serve -l 4173 .",
    "pluxee:build": "node pluxee/build.js",
    "pluxee:test": "NODE_PATH=$(npm root -g) node pluxee/tools/smoke.js",
    "pluxee:capture": "NODE_PATH=$(npm root -g) node pluxee/tools/capture.js"
  },
  "license": "UNLICENSED"
}
