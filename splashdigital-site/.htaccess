# Splash Digital – Apache ayarları (cPanel / LiteSpeed hostinglerde çalışır)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS'e yönlendir
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Eski WordPress adreslerini yeni bölümlere yönlendir (Google sıralamasını korur)
  RewriteRule ^(about-us|hakkimizda)/?$ /#hakkimizda [NE,L,R=301]
  RewriteRule ^(contact-us|iletisim)/?$ /#iletisim [NE,L,R=301]
  # Projeler: www.splashdigital.com.tr/projeler → projeler.html (PDF sayfa içinde önizlenir, indirilmez)
  RewriteRule ^projeler/$ /projeler [L,R=301]
  RewriteRule ^projeler$ /projeler.html [L]
  RewriteRule ^projelerimiz/?$ /projeler [L,R=301]
  RewriteRule ^hizmetlerimiz/?$ /#hizmetler [NE,L,R=301]
  RewriteRule ^markalarimiz/?$ /#markalar [NE,L,R=301]
  RewriteRule ^is-ortaklarimiz/?$ /#is-ortaklari [NE,L,R=301]
  RewriteRule ^hedeflemeler-ve-raporlama/?$ /#veri-odakli-stratejiler [NE,L,R=301]
  RewriteRule ^medya-ve-reklam-planlama/?$ /#medya-ve-reklam-planlama [NE,L,R=301]
  RewriteRule ^oasis-network-ve-uretim/?$ /#network-ve-uretim [NE,L,R=301]
  RewriteRule ^web-ve-mobil-gelistirme/?$ /#masaustu-ve-mobil [NE,L,R=301]
  RewriteRule ^pazarlama-ve-danismanlik/?$ /#pazarlama-ve-danismanlik [NE,L,R=301]
  RewriteRule ^kullanici-ve-yazilim-gelistirme/?$ /#yazilim-gelistirme [NE,L,R=301]
  RewriteRule ^(home|anasayfa)/?$ / [L,R=301]
  # WordPress kalıntıları (feed, wp-admin vb.) ana sayfaya
  RewriteRule ^(feed|comments/feed|wp-login\.php|wp-admin|xmlrpc\.php)(/.*)?$ / [L,R=301]
</IfModule>

# Sıkıştırma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Tarayıcı önbelleği
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

# Güvenlik başlıkları
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
